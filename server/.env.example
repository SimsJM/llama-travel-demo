# Copy to .env on the server and fill in. Never commit the real .env.
#
# Prefer a RESTRICTED key (rk_test_...) over a secret key (sk_test_...).
# This integration needs only:
#   Checkout Sessions  write   (create) AND read (the success page retrieves it)
#   Products, Prices   read
#   Webhook Endpoints  read
# A restricted key that leaks cannot drain an account the way a secret key can.

STRIPE_API_KEY=rk_test_replace_me

# From `node setup-catalog.js`, or the Dashboard price page.
STRIPE_PRICE_ID=price_replace_me

# From the webhook endpoint you create (whsec_...). Without this the webhook
# endpoint rejects everything and subscriptions never renew in your records.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Used to build success_url and cancel_url.
SITE_URL=https://llama.hauuuse.uk
